@model IEnumerable<Professeur>
@{
    ViewData["Title"] = "Professeurs";
}

<style>
    :root {
        --glass-bg: rgba(255, 255, 255, 0.25);
        --glass-border: rgba(255, 255, 255, 0.18);
        --glass-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
        --glass-shadow-hover: 0 16px 48px 0 rgba(31, 38, 135, 0.5);
        --gradient-warning: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
        --text-primary: #1e293b;
        --text-secondary: #64748b;
    }

    .page-header {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        border-radius: 24px;
        padding: 2.5rem;
        margin-bottom: 2.5rem;
        color: #1e293b;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(245, 158, 11, 0.2);
    }

    .page-header::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: inherit;
        filter: blur(40px);
        transform: scale(1.1);
        opacity: 0.8;
    }

    .table-container {
        background: var(--glass-bg);
        backdrop-filter: blur(20px);
        border: 1px solid var(--glass-border);
        border-radius: 20px;
        box-shadow: var(--glass-shadow);
        overflow: hidden;
    }

    .table-modern {
        margin: 0;
        border-radius: 0;
    }

    .table-modern thead th {
        background: rgba(255, 255, 255, 0.3);
        backdrop-filter: blur(10px);
        border: none;
        font-weight: 600;
        color: var(--text-primary);
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .table-modern tbody tr {
        transition: all 0.3s ease;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .table-modern tbody tr:hover {
        background: rgba(245, 158, 11, 0.1);
        transform: scale(1.01);
        box-shadow: 0 4px 12px rgba(245, 158, 11, 0.15);
    }

    .btn-action {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.1);
        color: var(--text-primary);
        margin: 0 3px;
    }

    .btn-action:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
    }

    .modal-modern .modal-content {
        background: var(--glass-bg);
        backdrop-filter: blur(20px);
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        box-shadow: var(--glass-shadow-hover);
    }

    .badge-modern {
        font-size: 0.75rem;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .badge-matricule {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: #1e293b;
        box-shadow: 0 4px 12px rgba(245, 158, 11, 0.2);
    }

    .empty-state {
        padding: 4rem 2rem;
        text-align: center;
        color: var(--text-secondary);
    }

    .btn-add-new {
        background: rgba(255, 255, 255, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.3);
        color: #1e293b;
        border-radius: 16px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        backdrop-filter: blur(10px);
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
    }

    .btn-add-new:hover {
        background: rgba(255, 255, 255, 0.3);
        transform: translateY(-2px);
        color: #1e293b;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    }

    .fade-in {
        animation: fadeInUp 0.6s ease forwards;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .form-floating-modern label {
        color: var(--text-secondary);
        font-weight: 500;
    }

    .skeleton {
        background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
        background-size: 200% 100%;
        animation: loading 1.5s infinite;
        border-radius: 8px;
    }

    @@keyframes loading {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }
</style>

<div class="container-fluid py-5">
    <!-- En-tête moderne -->
    <div class="page-header fade-in">
        <div class="d-flex justify-content-between align-items-center position-relative" style="z-index: 2;">
            <div>
                <h1 class="h2 mb-2 fw-bold"><i class="bi bi-person-badge me-3"></i>Gestion des professeurs</h1>
                <p class="mb-0 opacity-90">@Model.Count() professeurs enregistrés</p>
            </div>
            <a href="/Professeurs/Create" class="btn-add-new" id="btnNewProfessor">
                <i class="bi bi-person-plus"></i>Nouveau professeur
            </a>
        </div>
    </div>

    <!-- Tableau responsive -->
    <div class="card table-container fade-in">
        <div class="table-responsive">
            <table class="table table-modern mb-0">
                <thead>
                    <tr>
                        <th>Matricule</th>
                        <th>Nom complet</th>
                        <th>Email</th>
                        <th>Spécialité</th>
                        <th>Grade</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="empty-state">
                                <i class="bi bi-person-badge display-3 opacity-25 mb-4 d-block"></i>
                                <h4 class="mb-2">Aucun professeur trouvé</h4>
                                <p class="mb-0">Commencez par ajouter votre premier professeur.</p>
                            </td>
                        </tr>
                    }
                    @foreach (var prof in Model)
                    {
                        <tr class="fade-in">
                            <td>
                                <span class="badge badge-modern badge-matricule">@prof.Matricule</span>
                            </td>
                            <td>
                                <div>
                                    <strong class="d-block text-primary">@prof.Nom</strong>
                                    <small class="text-secondary">@prof.Prenom</small>
                                </div>
                            </td>
                            <td>
                                <small class="text-secondary d-block">@prof.Email</small>
                            </td>
                            <td>
                                <span class="badge bg-outline-primary badge-modern">@(prof.Specialite ?? "Non spécifiée")</span>
                            </td>
                            <td>
                                <span class="fw-semibold badge bg-outline-secondary badge-modern">@(prof.Grade ?? "Non spécifié")</span>
                            </td>
                            <td>
                                @if (prof.Actif)
                                {
                                    <span class="badge bg-success badge-modern">Actif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary badge-modern">Inactif</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn-action btn-outline-warning" onclick="loadProfEdit(@prof.Id)" title="Modifier">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <a href="/Professeurs/Delete/@prof.Id" class="btn-action btn-outline-danger" title="Supprimer" onclick="return confirm('Confirmer la suppression de ce professeur ?')">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Details Modal -->


<!-- Edit Modal -->


<script>
    // Scripts améliorés avec skeletons
    function showSkeleton(containerId) {
        document.getElementById(containerId).innerHTML = `
            <div class="row g-3">
                <div class="col-12"><div class="skeleton" style="height: 20px;"></div></div>
                <div class="col-md-6"><div class="skeleton" style="height: 40px;"></div></div>
                <div class="col-md-6"><div class="skeleton" style="height: 40px;"></div></div>
            </div>
        `;
    }

    function loadProfDetails(id) {
        showSkeleton('profDetailsContent');
        fetch(`/Professeurs/Details/${id}`)
            .then(response => response.text())
            .then(html => {
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const content = doc.querySelector('.card-body')?.innerHTML || html;
                document.getElementById('profDetailsContent').innerHTML = content;
                new bootstrap.Modal(document.getElementById('profDetailsModal')).show();
            })
            .catch(error => {
                console.error('Error:', error);
                document.getElementById('profDetailsContent').innerHTML = '<div class="alert alert-danger">Erreur de chargement.</div>';
                new bootstrap.Modal(document.getElementById('profDetailsModal')).show();
            });
    }

    function loadProfEdit(id) {
        showSkeleton('profEditContent');
        fetch(`/Professeurs/Edit/${id}`)
            .then(response => response.text())
            .then(html => {
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const form = doc.querySelector('form')?.outerHTML || html;
                document.getElementById('profEditContent').innerHTML = form;
                new bootstrap.Modal(document.getElementById('profEditModal')).show();
            })
            .catch(error => {
                console.error('Error:', error);
                document.getElementById('profEditContent').innerHTML = '<div class="alert alert-danger">Erreur de chargement.</div>';
                new bootstrap.Modal(document.getElementById('profEditModal')).show();
            });
    }

    // Gestion form create avec validation
    document.addEventListener('DOMContentLoaded', function() {
        const createForm = document.getElementById('createProfesseurForm');
        if (createForm) {
            createForm.addEventListener('submit', function(e) {
                e.preventDefault();
                
                if (!this.checkValidity()) {
                    e.stopPropagation();
                    this.classList.add('was-validated');
                    return;
                }

                const formData = new FormData(this);
                fetch('/Professeurs/Create', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.text())
                .then(html => {
                    if (html.includes('success') || html.includes('Validation')) {
                        bootstrap.Modal.getInstance(document.getElementById('createProfesseurModal')).hide();
                        location.reload();
                    } else {
                        document.getElementById('createProfesseurForm').innerHTML += '<div class="alert alert-danger mt-3">' + html + '</div>';
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Erreur serveur');
                });
            });
        }
    });

    // Debug du bouton Nouveau professeur
    document.getElementById('btnNewProfessor').addEventListener('click', function(e) {
        console.log('Bouton cliqué !');
        console.log('URL du lien :', this.getAttribute('href'));
        // Laisser le lien se comporter normalement
        return true;
    });
</script>
