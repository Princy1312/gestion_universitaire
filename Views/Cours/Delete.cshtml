@model Cours
@{
    ViewData["Title"] = "Supprimer le cours";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Confirmer la suppression</h4>
            </div>
            <div class="card-body text-center">
                <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex p-4 mb-3">
                    <i class="bi bi-book-x text-danger" style="font-size: 3rem;"></i>
                </div>
                <h5>@Model.Intitule</h5>
                <p class="text-muted">Code: @Model.Code</p>
                <p class="text-muted">Crédits: @Model.Credits</p>
                <p class="text-muted">Volume horaire: @Model.VolumeHoraire heures</p>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p class="text-muted">Description: @Model.Description</p>
                }

                <div class="alert alert-warning text-start">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>Attention !</strong> Cette action est irréversible. Toutes les inscriptions et notes associées à ce cours seront également supprimées.
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <a href="/Cours" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg me-2"></i>Annuler
                        </a>
                        <button type="submit" class="btn btn-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce cours ?')">
                            <i class="bi bi-trash me-2"></i>Supprimer définitivement
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
