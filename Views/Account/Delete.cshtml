@model ApplicationUser
@{
    ViewData["Title"] = "Supprimer le compte";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Confirmer la suppression</h4>
            </div>
            <div class="card-body text-center">
                <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex p-4 mb-3">
                    <i class="bi bi-person-x text-danger" style="font-size: 3rem;"></i>
                </div>
                <h5>@Model.Prenom @Model.Nom</h5>
                <p class="text-muted">Email: @Model.Email</p>
                <p class="text-muted">Date de création: @Model.DateCreation.ToShortDateString()</p>

                <div class="alert alert-warning text-start">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>Attention !</strong> Cette action est irréversible. Toutes les données associées à ce compte seront supprimées.
                </div>

                <form asp-action="DeleteAccount" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <a href="/Home" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg me-2"></i>Annuler
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-2"></i>Supprimer définitivement
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
