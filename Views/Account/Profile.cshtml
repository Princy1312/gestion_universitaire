@model ApplicationUser
@{
    ViewData["Title"] = "Mon Profil";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0"><i class="bi bi-person-badge me-2"></i>Profil Utilisateur</h4>
                        <span class="badge bg-white text-primary">@Model.UserName</span>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <!-- Photo de profil -->
                        <div class="col-lg-4 text-center mb-4 mb-lg-0">
                            <div class="position-relative d-inline-block mb-3">
                                @if (!string.IsNullOrEmpty(Model.PhotoProfil))
                                {
                                    <div class="position-relative">
                                        <img src="@Model.PhotoProfil" class="rounded-circle shadow" 
                                             style="width: 180px; height: 180px; object-fit: cover; border: 4px solid #f8f9fa; box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);" 
                                             alt="Photo de profil">
                                        <div class="position-absolute bottom-0 end-0 bg-primary rounded-circle p-2 border border-3 border-white shadow-sm">
                                            <i class="bi bi-camera-fill text-white"></i>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" 
                                         style="width: 180px; height: 180px; border: 2px dashed #dee2e6; margin: 0 auto;">
                                        <div class="text-center">
                                            <i class="bi bi-person-fill text-primary" style="font-size: 3.5rem;"></i>
                                            <div class="position-absolute bottom-0 end-0 bg-primary rounded-circle p-2 border border-3 border-white">
                                                <i class="bi bi-camera-fill text-white"></i>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            
                            <h5 class="mt-3 mb-1">@Model.Prenom @Model.Nom</h5>
                            <p class="text-muted mb-3">@Model.Email</p>
                            
                            <div class="d-grid gap-2">
                                <form asp-action="UploadProfilePhoto" asp-controller="Account" method="post" enctype="multipart/form-data">
                                    <label class="btn btn-outline-primary w-100 mb-2">
                                        <i class="bi bi-upload me-2"></i>Changer la photo
                                        <input type="file" name="photo" class="d-none" accept="image/*" required 
                                               onchange="this.form.submit()">
                                    </label>
                                    @if (TempData["ErrorMessage"] != null)
                                    {
                                        <div class="alert alert-danger alert-dismissible fade show mt-2" role="alert">
                                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                        </div>
                                    }
                                    <div class="text-muted small mt-2">Formats acceptés : JPG, PNG, GIF (max 5MB)</div>
                                </form>
                            </div>
                        </div>

                        <!-- Détails du profil -->
                        <div class="col-lg-8">
                            <div class="card border-0 mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="bi bi-person-lines-fill text-primary me-2"></i>Informations Personnelles</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-label text-muted small mb-1">Prénom</label>
                                                <div class="p-2 bg-light rounded">
                                                    <i class="bi bi-person-fill text-primary me-2"></i>
                                                    @(string.IsNullOrEmpty(Model.Prenom) ? "Non renseigné" : Model.Prenom)
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-label text-muted small mb-1">Nom</label>
                                                <div class="p-2 bg-light rounded">
                                                    <i class="bi bi-person-vcard-fill text-primary me-2"></i>
                                                    @(string.IsNullOrEmpty(Model.Nom) ? "Non renseigné" : Model.Nom)
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-group">
                                                <label class="form-label text-muted small mb-1">Adresse Email</label>
                                                <div class="p-2 bg-light rounded">
                                                    <i class="bi bi-envelope-fill text-primary me-2"></i>
                                                    @Model.Email
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-label text-muted small mb-1">Nom d'utilisateur</label>
                                                <div class="p-2 bg-light rounded">
                                                    <i class="bi bi-person-badge-fill text-primary me-2"></i>
                                                    @Model.UserName
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-label text-muted small mb-1">Membre depuis</label>
                                                <div class="p-2 bg-light rounded">
                                                    <i class="bi bi-calendar-check-fill text-primary me-2"></i>
                                                    @Model.DateCreation.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("fr-FR"))
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Actions du compte -->
                            <div class="card border-0">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="bi bi-gear-fill text-primary me-2"></i>Actions du Compte</h5>
                                </div>
                                <div class="card-body">
                                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                                        <div class="mb-3 mb-md-0">
                                            <h6 class="mb-1">Gestion du compte</h6>
                                            <p class="text-muted small mb-0">Modifiez vos paramètres et préférences</p>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <a href="/Account/Edit" class="btn btn-outline-primary">
                                                <i class="bi bi-pencil-square me-2"></i>Modifier le profil
                                            </a>
                                            <form method="post" action="/Account/Logout" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-secondary">
                                                    <i class="bi bi-box-arrow-right me-2"></i>Déconnexion
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                    <hr class="my-3">
                                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                                       
                                        <div>
                                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteAccountModal">
                                                <i class="bi bi-trash me-2"></i>Supprimer le compte
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de confirmation de suppression -->
<div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-labelledby="deleteAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteAccountModalLabel"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmer la suppression</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Êtes-vous sûr de vouloir supprimer définitivement votre compte ? Cette action est irréversible et toutes vos données seront perdues.</p>
                <p class="fw-bold">Cette action ne peut pas être annulée.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <form method="post" asp-action="DeleteAccount" asp-controller="Account" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer définitivement votre compte ? Cette action est irréversible.');">
                        <i class="bi bi-trash me-2"></i>Supprimer mon compte
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control-plaintext {
        padding: 0.5rem 0.75rem;
        background-color: #f8f9fa;
        border-radius: 0.375rem;
    }
    
    .card {
        border-radius: 0.75rem;
        overflow: hidden;
        transition: transform 0.2s ease-in-out;
    }
    
    .card:hover {
        transform: translateY(-3px);
    }
    
    .card-header {
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }
    
    .form-label {
        font-weight: 500;
    }
    
    .btn {
        border-radius: 0.5rem;
        padding: 0.5rem 1.25rem;
        font-weight: 500;
        transition: all 0.2s ease-in-out;
    }
    
    .btn i {
        margin-right: 0.5rem;
    }
    
    .bg-light {
        background-color: #f8f9fa !important;
    }
    
    .text-primary {
        color: #0d6efd !important;
    }
    
    .btn-primary {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }
    
    .btn-outline-primary {
        color: #0d6efd;
        border-color: #0d6efd;
    }
    
    .btn-outline-primary:hover {
        background-color: #0d6efd;
        color: white;
    }
    
    .btn-outline-danger {
        color: #dc3545;
        border-color: #dc3545;
    }
    
    .btn-outline-danger:hover {
        background-color: #dc3545;
        color: white;
    }
</style>
