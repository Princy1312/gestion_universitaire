@model ApplicationUser
@{
    ViewData["Title"] = "Mon Profil";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-person-circle me-2"></i>Mon Profil</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 text-center mb-4">
                        <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex p-4 mb-3">
                            <i class="bi bi-person-fill text-primary" style="font-size: 3rem;"></i>
                        </div>
                        <h5>@Model.Prenom @Model.Nom</h5>
                        <p class="text-muted">@Model.Email</p>
                    </div>
                    <div class="col-md-8">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label class="form-label fw-bold">Prénom</label>
                                <p class="form-control-plaintext">@Model.Prenom</p>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label fw-bold">Nom</label>
                                <p class="form-control-plaintext">@Model.Nom</p>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold">Email</label>
                                <p class="form-control-plaintext">@Model.Email</p>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold">Date de création</label>
                                <p class="form-control-plaintext">@Model.DateCreation.ToShortDateString()</p>
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="my-4">

                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-0">Actions du compte</h6>
                    </div>
                    <div>
                        <form method="post" action="/Account/Logout" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary me-2">
                                <i class="bi bi-box-arrow-right me-2"></i>Se déconnecter
                            </button>
                        </form>
                        <a href="/Account/Delete" class="btn btn-outline-danger">
                            <i class="bi bi-trash me-2"></i>Supprimer mon compte
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
