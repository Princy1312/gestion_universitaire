@model Etudiant
@{
    ViewData["Title"] = "Détails de l'étudiant";
}

<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex p-4 mb-3">
                    <i class="bi bi-person-circle text-primary" style="font-size: 4rem;"></i>
                </div>
                <h4>@Model.Prenom @Model.Nom</h4>
                <span class="badge bg-primary">@Model.Matricule</span>
                <div class="mt-2">
                    @if (Model.Actif)
                    {
                        <span class="badge bg-success">Actif</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactif</span>
                    }
                </div>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted"><i class="bi bi-envelope me-2"></i>Email</span>
                    <span>@Model.Email</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted"><i class="bi bi-telephone me-2"></i>Téléphone</span>
                    <span>@(Model.Telephone ?? "-")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted"><i class="bi bi-calendar me-2"></i>Naissance</span>
                    <span>@Model.DateNaissance.ToString("dd/MM/yyyy")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted"><i class="bi bi-calendar-check me-2"></i>Inscription</span>
                    <span>@Model.DateInscription.ToString("dd/MM/yyyy")</span>
                </li>
            </ul>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="/Etudiants/Edit/@Model.Id" class="btn btn-warning">
                        <i class="bi bi-pencil me-2"></i>Modifier
                    </a>
                    <a href="/Etudiants" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i>Retour
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-book me-2"></i>Cours inscrits</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Intitulé</th>
                            <th>Crédits</th>
                            <th>Statut</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Inscriptions.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-3 text-muted">Aucune inscription</td>
                            </tr>
                        }
                        @foreach (var inscription in Model.Inscriptions)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">@inscription.Cours?.Code</span></td>
                                <td>@inscription.Cours?.Intitule</td>
                                <td>@inscription.Cours?.Credits</td>
                                <td><span class="badge bg-info">@inscription.Statut</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-clipboard-data me-2"></i>Notes</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Cours</th>
                            <th>Type</th>
                            <th>Note</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Notes.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-3 text-muted">Aucune note</td>
                            </tr>
                        }
                        @foreach (var note in Model.Notes.OrderByDescending(n => n.DateEvaluation))
                        {
                            <tr>
                                <td>@note.Cours?.Intitule</td>
                                <td>@note.TypeEvaluation</td>
                                <td>
                                    <span class="badge @(note.Valeur >= 10 ? "bg-success" : "bg-danger")">
                                        @note.Valeur.ToString("0.00")/20
                                    </span>
                                </td>
                                <td>@note.DateEvaluation.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
